  "views": {
    "ulmiversitaet.meal_rating_stats": {
      "columns": {
        "meal_id": {
          "name": "meal_id",
          "type": "uuid",
          "primaryKey": false,
          "notNull": true
        }
      },
      "definition": "select \"meal_id\", count(*)::int as \"count\", avg(\"taste\")::real as \"taste\", avg(\"look\")::real as \"look\", avg(\"price\")::real as \"price\", avg(\"total\")::real as \"total\", ((count(*) * avg(\"total\") + 2 * 3.0) / (count(*) + 2))::real as \"score\" from \"ulmiversitaet\".\"meal_ratings\" where \"ulmiversitaet\".\"meal_ratings\".\"hidden_at\" is null group by \"ulmiversitaet\".\"meal_ratings\".\"meal_id\"",
      "name": "meal_rating_stats",
      "schema": "ulmiversitaet",
      "isExisting": false,
      "materialized": false
    }
