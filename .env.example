# Neon connection string (pooled) used by the app
NEON_DATABASE_URL=
# Optional: role with DDL rights, used by drizzle-kit only
NEON_DATABASE_URL_ADMIN=

# Vercel cron jobs (mensa scraper)
CRON_SECRET=

# Admin dashboard (/admin). Use a long password; SESSION_SECRET at least 32 characters
ADMIN_USERNAME=
ADMIN_PASSWORD=
SESSION_SECRET=

# Mensa guru (optional, free key from https://aistudio.google.com/apikey); hidden without a key
GEMINI_API_KEY=
# Optional: model of the guru (default: gemini-3.5-flash-lite)
GEMINI_MODEL=
