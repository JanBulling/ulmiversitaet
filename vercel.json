{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "schedules": {
    "mensa-next-week": {
      "schedule": "0 7 * * 1",
      "timezone": "Europe/Berlin",
      "path": "/api/cron/mensa/next-week",
      "requestMethod": "GET"
    },
    "mensa-today": {
      "schedule": "0 8 * * 1-5",
      "timezone": "Europe/Berlin",
      "path": "/api/cron/mensa/today",
      "requestMethod": "GET"
    }
  }
}
